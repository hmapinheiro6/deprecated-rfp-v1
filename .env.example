# RFP Scraper Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# Required: Slack webhook URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/workflows/YOUR/WORKFLOW/URL

# Optional: Google Sheets webhook URL (Apps Script)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Required: SAM.gov API key (get free key at https://open.gsa.gov/api/opportunities-api/)
SAM_GOV_API_KEY=your_api_key_here

# Optional: Path to deduplication storage (default: data/seen_rfps.json)
DEDUP_STORAGE_PATH=data/seen_rfps.json
